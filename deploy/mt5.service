[Unit]
Description=MetaTrader 5 terminal under Wine
Requires=xvfb.service
After=xvfb.service network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Environment=DISPLAY=:99
Environment=WINEPREFIX=/home/ubuntu/.wine
Environment=WINEDEBUG=-all
ExecStart=/usr/bin/wine "/home/ubuntu/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
